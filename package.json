    "vite": "^7.0.0",
    "typescript": "~5.9.3",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.2.0",
    "jsdom": "^26.0.0",
    "fake-indexeddb": "^6.0.0",
